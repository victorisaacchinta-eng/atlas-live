# Server-side only (Vercel project settings). Never prefix with VITE_.
# Set ONE model key. The first one found wins, in this order:
NEBIUS_API_KEY=        # Nebius Token Factory (required for the Nebius x NVIDIA submission)
TOKEN_FACTORY_URL=     # optional: your account's regional base URL, e.g. https://api.tokenfactory.us-central1.nebius.com/v1
NVIDIA_API_KEY=        # build.nvidia.com API catalog (Nemotron, free tier)
GEMINI_API_KEY=        # Google AI Studio
GROQ_API_KEY=          # Groq
TAVILY_API_KEY=        # web search with citations

# Optional: exact model ids for the active provider
ATLAS_VISION_MODEL=
ATLAS_AGENT_MODEL=
ATLAS_FAST_MODEL=

# Real 3D places (Google Photorealistic 3D Tiles). Set ONE. These reach the browser,
# so restrict them to your site's URL in the provider console.
CESIUM_ION_TOKEN=      # ion.cesium.com, free Community plan, add asset 2275207 to My Assets
GOOGLE_MAPS_KEY=       # Google Cloud, Map Tiles API enabled (billing account required)
