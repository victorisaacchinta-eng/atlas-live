# Server-side only (Vercel project settings). Never prefix with VITE_.
# Set ONE model key. The first one found wins, in this order:
NEBIUS_API_KEY=        # Nebius Token Factory (required for the Nebius x NVIDIA submission)
NVIDIA_API_KEY=        # build.nvidia.com API catalog (Nemotron, free tier)
GEMINI_API_KEY=        # Google AI Studio
GROQ_API_KEY=          # Groq
TAVILY_API_KEY=        # web search with citations

# Optional: exact model ids for the active provider
ATLAS_VISION_MODEL=
ATLAS_AGENT_MODEL=
ATLAS_FAST_MODEL=
